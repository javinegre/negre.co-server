# Copy to .env for local development. Never commit the real .env.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
AUTH_RP_ID=localhost
AUTH_DB_PATH=./data/auth.db

# Comma-separated allowlist for /backoffice. Unset means nobody gets in.
ADMIN_EMAILS=

# Required by apis/bicing-api to proxy Open Data BCN. Get one at
# https://opendata-ajuntament.barcelona.cat/
OPEN_DATA_BCN_ACCESS_TOKEN=
