{
  "name": "negre.co-server",
  "version": "0.0.1",
  "description": "negre.co Router",
  "main": "server.ts",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@types/express": "^4.17.11",
    "@types/node": "^20.0.0",
    "express": "4.17.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
